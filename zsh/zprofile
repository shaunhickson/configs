eval "$(/opt/homebrew/bin/brew shellenv)"

# brew shellenv prepends /opt/homebrew/{bin,sbin} to the FRONT of PATH, which
# lets any Homebrew formula shadow its nix equivalent. Put the nix profiles
# back in front. `typeset -U` then drops duplicates, keeping the leftmost
# occurrence, so the entries brew added survive further down the list.
path=(
  "$HOME/.nix-profile/bin"
  "/etc/profiles/per-user/$USER/bin"
  /run/current-system/sw/bin
  /nix/var/nix/profiles/default/bin
  $path
)
typeset -U path PATH
