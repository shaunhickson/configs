# --- 1. PATH & ENVIRONMENT ---------------------------------------------------

# Initialize Homebrew, but only if a login shell hasn't already done it --
# .zprofile runs this too, and brew shellenv unconditionally re-prepends
# /opt/homebrew to the FRONT of PATH every time it is evaluated.
if [[ -z "$HOMEBREW_PREFIX" ]]; then
    if [[ -f "/opt/homebrew/bin/brew" ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f "/usr/local/bin/brew" ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

# Keep nix ahead of Homebrew no matter which init files ran for this shell
# (login vs non-login differ). typeset -U keeps the leftmost of each duplicate.
path=(
  "$HOME/.nix-profile/bin"
  "/etc/profiles/per-user/$USER/bin"
  /run/current-system/sw/bin
  /nix/var/nix/profiles/default/bin
  $path
)
typeset -U path PATH

# Go (Golang) Path Setup
# This ensures you can run tools you install with 'go install'
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

# Gastown path .local stuff
export PATH="$PATH:$HOME/.local/bin"

# Editor Defaults
export EDITOR="code --wait" # VS Code is your default editor for git commit messages

# --- 2. HISTORY CONFIGURATION ------------------------------------------------
# Don't lose your history. Keep 50,000 commands.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

# History Options (The "Sanity" Settings)
setopt SHARE_HISTORY          # Share history between different terminal tabs immediately
setopt APPEND_HISTORY         # Append to file, don't overwrite
setopt HIST_IGNORE_DUPS       # Don't record a command if it matches the previous one
setopt HIST_IGNORE_SPACE      # Ignore commands starting with a space (useful for secrets)
setopt HIST_VERIFY            # Show command with ! expansion before running it

# --- 3. COMPLETION SYSTEM ----------------------------------------------------
# This enables the tab-completion logic for git, brew, etc.
autoload -Uz compinit
compinit

# --- 4. MODERN TOOLS INITIALIZATION ------------------------------------------

# Starship (The Prompt)
# Provides git status, go version, etc. right in your prompt.
#if command -v starship &> /dev/null; then
#    eval "$(starship init zsh)"
#fi

# Zoxide (Smarter 'cd')
# Learns your frequent folders. Type 'z repo' to jump to ~/src/repo.
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# --- 5. ALIASES --------------------------------------------------------------
# Shortcuts for high-frequency actions.

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ll="ls -lah" # List all, readable sizes, hidden files

# Git (The essentials)
alias gs="git status"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate"
alias gcm="git commit -m"
alias gp="git push"

# Productivity
alias zconf="code ~/.zshrc"        # Quickly edit this file
alias zreload="source ~/.zshrc"    # Reload config after editing
alias c="clear"
alias brewup="brew update && brew upgrade && brew cleanup"

# --- 6. PLUGINS (NIX MANAGED) ------------------------------------------------
# Installed via home-manager. The two packages do NOT share a directory layout
# in nixpkgs -- autosuggestions nests under share/zsh/plugins/, syntax
# highlighting sits directly under share/. Don't "tidy" these into one pattern.
_nixshare="/etc/profiles/per-user/$USER/share"

# Autosuggestions (Grey ghost text)
if [ -f "$_nixshare/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "$_nixshare/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
    # Keybinding: Accept suggestion with Ctrl + Space (keeps hands on home row)
    bindkey '^ ' autosuggest-accept
fi

# Syntax Highlighting (Green=Valid, Red=Invalid)
# MUST BE LAST: This wraps the line editor, so it must load after everything else.
if [ -f "$_nixshare/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source "$_nixshare/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
unset _nixshare

# Kubernetes dev environment settings
export working_dir="${GOPATH}/src/k8s.io" # Change to your preferred location for source code
export user=shaunhickson

