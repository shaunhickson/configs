# --- gcloud -----------------------------------------------------------------
# gcloud state now lives in ~/.local/state/gcloud via CLOUDSDK_CONFIG, so it
# should never reappear here. Kept as a guard in case that variable is lost.
gcloud/

# Belt and braces: never track credentials, wherever they turn up.
**/application_default_credentials.json
**/credentials.db
**/access_tokens.db
**/legacy_credentials/

# --- gh ---------------------------------------------------------------------
# gh writes oauth tokens into hosts.yml. Never track it.
gh/hosts.yml

# --- home-manager -----------------------------------------------------------
# ~/.config is a symlink to this repo, so home-manager's activation backups
# land here. Never track them.
*.hm-bak

# --- editors / OS -----------------------------------------------------------
.DS_Store

# --- nix --------------------------------------------------------------------
result
result-*
